{
  "name": "@workspace/sci-cream",
  "version": "0.0.9",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema-category": {
      "import": "./src/ts/schema-category.js",
      "require": "./src/ts/schema-category.js"
    }
  },
  "files": [
    "dist",
    "src/ts"
  ],
  "scripts": {
    "install:wasm": "cargo install wasm-pack && rustup target add wasm32-unknown-unknown",
    "install:insta": "cargo install cargo-insta",
    "build:rust": "cargo build --all-features --all-targets",
    "gen:footnotes": "./scripts/split-ref-footnotes.sh",
    "gen:footnotes:check": "./scripts/split-ref-footnotes.sh --check",
    "gen:data": "node --import tsx scripts/gen-data.ts",
    "gen:data:min": "node --import tsx scripts/gen-data.ts --min",
    "gen:data:check": "node --import tsx scripts/gen-data.ts --check",
    "gen:doc-links": "node --import tsx scripts/gen-doc-links.ts",
    "gen:doc-links:check": "node --import tsx scripts/gen-doc-links.ts --check",
    "gen:all": "pnpm gen:footnotes && pnpm gen:data:min && pnpm gen:doc-links && pnpm gen:data",
    "gen:all:check": "pnpm gen:footnotes:check && pnpm gen:data:check && pnpm gen:doc-links:check",
    "build:package": "pnpm gen:data && pnpm doc:site && pnpm build:wasm && pnpm build:js",
    "build:wasm": "pnpm set-crate-type:cdylib && pnpm build:wasm-pack && pnpm set-crate-type:rlib",
    "build:wasm-pack": "wasm-pack build --out-dir wasm --out-name index -- --features \"wasm,data,database\"",
    "set-crate-type:cdylib": "./scripts/set-crate-type.sh ./Cargo.toml cdylib",
    "set-crate-type:rlib": "./scripts/set-crate-type.sh ./Cargo.toml rlib",
    "build:js": "vite build",
    "test": "pnpm test:rust && pnpm test:js",
    "test:rust": "cargo test --all-features",
    "test:js": "vitest run",
    "snapshots:update": "pnpm snapshots:rust:accept && pnpm snapshots:js:update",
    "snapshots:rust:review": "cargo insta test --all-features --review",
    "snapshots:rust:accept": "cargo insta test --all-features --accept",
    "snapshots:js:update": "vitest run --update",
    "lint": "pnpm lint:rust && pnpm lint:js",
    "lint:rust": "cargo clippy --all-features --all-targets",
    "lint:js": "eslint src --ext .ts --max-warnings=0",
    "fmt:check": "pnpm rustfmt && pnpm prettier",
    "rustfmt": "cargo fmt --all -- --check",
    "prettier": "prettier --check ./src/ts",
    "coverage": "pnpm coverage:rust && pnpm coverage:js",
    "coverage:rust": "pnpm coverage:rust:generate && pnpm coverage:rust:codecov && pnpm coverage:rust:html",
    "coverage:rust:generate": "cargo +nightly llvm-cov test --all-features",
    "coverage:rust:codecov": "cargo +nightly llvm-cov report --codecov --output-path ../../target/codecov_code_coverage.json",
    "coverage:rust:html": "cargo +nightly llvm-cov report --html",
    "coverage:js": "vitest run --coverage",
    "bench": "pnpm bench:rust && pnpm bench:js && pnpm bench:size",
    "bench:rust": "cargo criterion --all-features",
    "bench:js": "node --import tsx benches/ts/run-all.ts",
    "bench:size": "node --import tsx benches/sizes/measure.ts",
    "doc": "cargo doc --all-features --no-deps --document-private-items",
    "doc:examples": "cargo doc --all-features --no-deps --document-private-items --examples",
    "doc:site": "cargo clean --doc && cargo rustdoc --lib --all-features -- --cfg sci_cream_site_docs"
  },
  "dependencies": {
    "eslint-plugin-jsdoc": "^65.4.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/benchmark": "^2.1.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "benchmark": "^2.1.4",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "marked": "^18.2.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.73.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.12"
  }
}
