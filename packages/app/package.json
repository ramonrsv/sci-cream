{
  "name": "@workspace/sci-cream-app",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "install:deps": "pnpm --dir ../sci-cream install:wasm",
    "build:deps": "pnpm --dir ../sci-cream build:package",
    "copy:rustdoc": "./scripts/copy-rustdoc.sh",
    "gen:data": "pnpm --dir ../sci-cream gen:data",
    "build:analyze": "ANALYZE=true next build --webpack",
    "build": "pnpm copy:rustdoc && next build",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:visual",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project chromium firefox webkit mobile-chrome mobile-safari",
    "test:e2e:chromium": "playwright test --project chromium",
    "test:e2e:ui": "pnpm test:e2e --ui",
    "test:visual": "playwright test --project visual",
    "test:visual:update": "pnpm test:visual --update-snapshots",
    "lint": "eslint ./src ./scripts --max-warnings=0",
    "lint:sql": "squawk drizzle/*.sql",
    "prettier": "prettier --check ./src ./scripts",
    "coverage": "vitest run --coverage",
    "bench": "pnpm bench:unit && pnpm bench:bundle && pnpm bench:e2e && pnpm bench:web-vitals",
    "bench:unit": "node --import tsx src/__benches__/unit/run-all.ts",
    "bench:bundle": "node --import tsx src/__benches__/bundle/measure.ts",
    "bench:e2e": "playwright test --project benches --grep-invert 'Web Vitals' --reporter='dot'",
    "bench:web-vitals": "playwright test --project benches --grep 'Web Vitals' --reporter='dot'",
    "dev": "pnpm dev:turbopack",
    "dev:turbopack": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "pnpm tsx ./scripts/baseline.ts",
    "seed-db": "pnpm db:migrate && pnpm tsx ./scripts/seed.ts",
    "doc": "tsc --noEmit false --outDir ./dist && jsdoc -c ./jsdoc.config.json"
  },
  "dependencies": {
    "@fontsource/noto-emoji": "5.3.2",
    "@headlessui/react": "^2.2.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "@workspace/sci-cream": "workspace:*",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "colord": "^2.14.0",
    "docdash": "^2.0.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "eslint-plugin-jsdoc": "^65.4.11",
    "geist": "^1.9.2",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.1.0",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "react-resizable": "^4.0.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vitest-canvas-mock": "^1.2.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/bcryptjs": "^3.0.0",
    "@types/benchmark": "^2.1.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "benchmark": "^2.1.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdoc": "^4.0.5",
    "jsdoc-plugin-typescript": "^3.2.1",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "squawk-cli": "^2.73.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
